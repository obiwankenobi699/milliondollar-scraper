ADMIN_ACCESS_HASH=***generate-with-openssl-rand-hex-32***
SCRAPER_SECRET=***generate-with-openssl-rand-hex-32***
JWT_SECRET=***generate-with-openssl-rand-hex-32***
CORS_ALLOWED_ORIGINS=https://your-wearbids-app.vercel.app,http://localhost:3000
COOKIE_SECURE=1

# Upstash Redis (for image cache) — get from Upstash Console
UPSTASH_REDIS_REST_URL=https://***.upstash.io
UPSTASH_REDIS_REST_TOKEN=***
SCRAPER_CACHE_TTL_SECONDS=1800

# Optional: keep curated source rows when real official scraping is blocked.
# Set to 0 only when every enabled source has a real parser.
ALLOW_CURATED_FALLBACKS=1

# Optional: fallback images when official event images are missing.
# Requires following Unsplash API terms/attribution guidance in the app UI.
UNSPLASH_ACCESS_KEY=
